<?xml version="1.0" encoding="utf-8"?>
<!-- Reschedule a waiting pickup: choose another day and time slot -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/textCurrent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_banner"
            android:padding="12dp"
            android:textColor="@color/placeholder_ink"
            android:textSize="13sp"
            tools:text="Now: Fri, Nov 13 at 5:00 PM" />

        <!-- at the top so it is never hidden below the calendar and time slots -->
        <TextView
            android:id="@+id/textRescheduleError"
            style="@style/Widget.SaluBite.ErrorLabel"
            android:layout_marginTop="8dp"
            android:textStyle="bold" />

        <CalendarView
            android:id="@+id/calendarReschedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:theme="@style/Theme.Sagana.Calendar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_time_slot"
            android:textColor="@color/adobo"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupReschedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingBottom="8dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"
            app:singleSelection="true"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>
</ScrollView>
