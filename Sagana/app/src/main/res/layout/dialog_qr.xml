<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/imageQrLarge"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:background="@color/white"
        android:contentDescription="@string/cd_qr" />

    <TextView
        android:id="@+id/textQrCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.15"
        android:textColor="@color/chili"
        android:textSize="30sp"
        android:textStyle="bold"
        tools:text="SG-7K2P" />

    <TextView
        android:id="@+id/textQrInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        tools:text="Pancit bihon · Fri, Nov 13, 5:00 PM\nBrgy. Tangub social welfare desk" />
</LinearLayout>
