<?xml version="1.0" encoding="utf-8"?>
<!-- Opening screen. Every piece is animated from SplashActivity. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash"
    tools:context=".SplashActivity">

    <!-- Food sparkles drifting upward behind everything -->
    <com.example.sagana.ParticleView
        android:id="@+id/particles"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Sonar rings: food reaching neighbors nearby -->
    <com.example.sagana.RippleRingsView
        android:id="@+id/rings"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <FrameLayout
            android:id="@+id/logoGroup"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:clipChildren="false">

            <View
                android:id="@+id/glow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="-40dp"
                android:background="@drawable/bg_splash_glow" />

            <ImageView
                android:id="@+id/steam1"
                android:layout_width="16dp"
                android:layout_height="36dp"
                android:layout_marginStart="56dp"
                android:layout_marginTop="34dp"
                android:importantForAccessibility="no"
                android:src="@drawable/splash_steam" />

            <ImageView
                android:id="@+id/steam2"
                android:layout_width="16dp"
                android:layout_height="36dp"
                android:layout_marginStart="77dp"
                android:layout_marginTop="30dp"
                android:importantForAccessibility="no"
                android:src="@drawable/splash_steam" />

            <ImageView
                android:id="@+id/steam3"
                android:layout_width="16dp"
                android:layout_height="36dp"
                android:layout_marginStart="98dp"
                android:layout_marginTop="34dp"
                android:importantForAccessibility="no"
                android:src="@drawable/splash_steam" />

            <FrameLayout
                android:id="@+id/bowlGroup"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/bowl"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_logo"
                    android:src="@drawable/splash_bowl" />

                <ImageView
                    android:id="@+id/heart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/splash_heart" />
            </FrameLayout>
        </FrameLayout>

        <!-- Each letter of the name is added here in code so they can bounce in one by one -->
        <LinearLayout
            android:id="@+id/nameRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:clipChildren="false"
            android:orientation="horizontal" />

        <View
            android:id="@+id/underline"
            android:layout_width="96dp"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_splash_bar_fill" />

        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/login_tagline"
            android:textColor="#FFE3A3"
            android:textSize="15sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/bar"
            android:layout_width="160dp"
            android:layout_height="5dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_splash_bar">

            <View
                android:id="@+id/barFill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_splash_bar_fill" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:text="@string/splash_footer"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp" />
</FrameLayout>
