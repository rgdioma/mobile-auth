<?xml version="1.0" encoding="utf-8"?>
<!-- Staff Desk: shown when a scanned or typed code matches a waiting pickup -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/leaf"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textMatch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:text="@string/desk_code_matches"
            android:textColor="@color/leaf"
            android:textSize="13sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_rule_met" />

        <TextView
            android:id="@+id/textFood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/adobo"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Pancit bihon" />

        <TextView
            android:id="@+id/textQtyDonor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="2 packs · from Aling Nena's Carinderia" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_receiver"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textReceiver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/adobo"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Maria Santos" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/label_scheduled"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textScheduled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/adobo"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Fri, Nov 13, 5:00 PM" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonHandOver"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/chili"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/action_hand_over"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_verified"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
