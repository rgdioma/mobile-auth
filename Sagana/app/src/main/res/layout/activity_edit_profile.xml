<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/editProfileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rice"
    android:fillViewport="true"
    tools:context=".EditProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/buttonBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/action_edit_profile"
                android:textColor="@color/adobo"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Profile photo -->
        <FrameLayout
            android:id="@+id/avatarFrame"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <LinearLayout
                android:id="@+id/avatarPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_profile"
                    app:tint="@color/placeholder_ink" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/avatarCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:cardCornerRadius="52dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mango"
                app:strokeWidth="2dp">

                <ImageView
                    android:id="@+id/imageAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_avatar"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <TextView
            android:id="@+id/textChangePhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackground"
            android:padding="4dp"
            android:text="@string/change_photo"
            android:textColor="@color/chili"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Personal details -->
        <TextView
            style="@style/Widget.SaluBite.SectionTitle"
            android:text="@string/section_details" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.SaluBite.FieldLabel"
                    android:labelFor="@+id/editFirstName"
                    android:text="@string/label_first_name" />

                <EditText
                    android:id="@+id/editFirstName"
                    style="@style/Widget.SaluBite.Field"
                    android:autofillHints="personGivenName"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="40" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.SaluBite.FieldLabel"
                    android:labelFor="@+id/editLastName"
                    android:text="@string/label_last_name" />

                <EditText
                    android:id="@+id/editLastName"
                    style="@style/Widget.SaluBite.Field"
                    android:autofillHints="personFamilyName"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="40" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Widget.SaluBite.FieldLabel"
            android:layout_marginTop="14dp"
            android:labelFor="@+id/editEmail"
            android:text="@string/label_email" />

        <EditText
            android:id="@+id/editEmail"
            style="@style/Widget.SaluBite.Field"
            android:autofillHints="emailAddress"
            android:inputType="textEmailAddress" />

        <TextView
            style="@style/Widget.SaluBite.FieldHint"
            android:text="@string/email_change_hint" />

        <TextView
            style="@style/Widget.SaluBite.FieldLabel"
            android:layout_marginTop="14dp"
            android:labelFor="@+id/editMobile"
            android:text="@string/label_mobile" />

        <EditText
            android:id="@+id/editMobile"
            style="@style/Widget.SaluBite.Field"
            android:autofillHints="phone"
            android:inputType="phone"
            android:maxLength="11" />

        <TextView
            style="@style/Widget.SaluBite.FieldHint"
            android:text="@string/mobile_change_hint" />

        <TextView
            style="@style/Widget.SaluBite.FieldLabel"
            android:layout_marginTop="14dp"
            android:text="@string/label_barangay" />

        <Spinner
            android:id="@+id/spinnerBarangay"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:entries="@array/barangays"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:spinnerMode="dropdown" />

        <LinearLayout
            android:id="@+id/staffSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Widget.SaluBite.FieldLabel"
                android:layout_marginTop="14dp"
                android:labelFor="@+id/editStaffId"
                android:text="@string/label_staff_id" />

            <EditText
                android:id="@+id/editStaffId"
                style="@style/Widget.SaluBite.Field"
                android:autofillHints="none"
                android:hint="@string/hint_staff_id"
                android:inputType="textCapCharacters"
                android:maxLength="9" />
        </LinearLayout>

        <TextView
            android:id="@+id/errorDetails"
            style="@style/Widget.SaluBite.ErrorLabel"
            android:layout_marginTop="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSaveDetails"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/chili"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/action_save_changes"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_save"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />

        <!-- Change password -->
        <TextView
            style="@style/Widget.SaluBite.SectionTitle"
            android:text="@string/section_password" />

        <TextView
            style="@style/Widget.SaluBite.FieldLabel"
            android:labelFor="@+id/editCurrentPassword"
            android:text="@string/label_current_password" />

        <EditText
            android:id="@+id/editCurrentPassword"
            style="@style/Widget.SaluBite.Field"
            android:autofillHints="password"
            android:inputType="textPassword" />

        <TextView
            style="@style/Widget.SaluBite.FieldLabel"
            android:layout_marginTop="14dp"
            android:labelFor="@+id/editNewPassword"
            android:text="@string/label_new_password" />

        <EditText
            android:id="@+id/editNewPassword"
            style="@style/Widget.SaluBite.Field"
            android:autofillHints="newPassword"
            android:hint="@string/hint_new_password"
            android:inputType="textPassword" />

        <ProgressBar
            android:id="@+id/progressStrength"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="5"
            android:progressDrawable="@drawable/bg_strength_bar" />

        <TextView
            android:id="@+id/textPasswordRules"
            style="@style/Widget.SaluBite.FieldHint"
            android:text="@string/password_rules_line" />

        <TextView
            style="@style/Widget.SaluBite.FieldLabel"
            android:layout_marginTop="14dp"
            android:labelFor="@+id/editConfirmPassword"
            android:text="@string/label_confirm_password" />

        <EditText
            android:id="@+id/editConfirmPassword"
            style="@style/Widget.SaluBite.Field"
            android:autofillHints="newPassword"
            android:hint="@string/hint_confirm_password"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/errorPassword"
            style="@style/Widget.SaluBite.ErrorLabel"
            android:layout_marginTop="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonChangePassword"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/action_change_password"
            android:textAllCaps="false"
            android:textColor="@color/chili"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_lock"
            app:iconGravity="textStart"
            app:iconTint="@color/chili"
            app:strokeColor="@color/chili" />

        <!-- Delete account -->
        <TextView
            style="@style/Widget.SaluBite.SectionTitle"
            android:text="@string/section_delete" />

        <TextView
            style="@style/Widget.SaluBite.FieldHint"
            android:layout_marginTop="0dp"
            android:text="@string/delete_account_hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDeleteAccount"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/action_delete_account"
            android:textAllCaps="false"
            android:textColor="@color/chili"
            android:textSize="15sp"
            app:icon="@drawable/ic_delete"
            app:iconGravity="textStart"
            app:iconTint="@color/chili" />
    </LinearLayout>
</ScrollView>
