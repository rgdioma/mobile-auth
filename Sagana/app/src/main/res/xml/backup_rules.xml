<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 and lower (Android 12+ uses data_extraction_rules.xml).
   The session (who is logged in, and whether onboarding was seen) belongs to this install only.
   If it were backed up, reinstalling the app would silently log the user back in and skip
   the onboarding screens.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="sagana_session.xml" />
</full-backup-content>
