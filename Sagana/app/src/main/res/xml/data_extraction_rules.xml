<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 12+.
   The session (who is logged in, and whether onboarding was seen) belongs to this install only.
   If it were restored, a fresh install would skip onboarding and log someone straight in.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sagana_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sagana_session.xml" />
    </device-transfer>
</data-extraction-rules>
