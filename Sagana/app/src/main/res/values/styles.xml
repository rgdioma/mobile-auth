<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Category filter chips -->
    <style name="Widget.SaluBite.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textAppearance">@style/TextAppearance.SaluBite.Chip</item>
        <item name="chipStrokeColor">@color/input_border</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="TextAppearance.SaluBite.Chip" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/chip_text</item>
    </style>

    <!-- Bottom navigation -->
    <style name="Widget.SaluBite.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/chili_light</item>
    </style>

    <style name="TextAppearance.SaluBite.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.SaluBite.NavLabel.Active">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Time slot chips -->
    <style name="Widget.SaluBite.TimeChip" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipBackgroundColor">@color/time_chip_bg</item>
        <item name="android:textColor">@color/time_chip_text</item>
        <item name="chipStrokeColor">@color/input_border</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <!-- Registration -->
    <style name="Widget.SaluBite.ErrorLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/chili</item>
        <item name="android:textSize">12sp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="Widget.SaluBite.PasswordRule" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:drawableStart">@drawable/ic_rule_unmet</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.SaluBite.RoleChoice" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_choice</item>
        <item name="android:buttonTint">@color/chili</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/adobo</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Calendar -->
    <style name="Theme.Sagana.Calendar" parent="Theme.Sagana">
        <item name="android:colorAccent">@color/chili</item>
    </style>
</resources>
