<?xml version="1.0" encoding="utf-8"?>
<!-- Butter circle with a dashed mango edge, matching the photo placeholder style -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/butter" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="@color/mango"
                android:dashWidth="5dp"
                android:dashGap="4dp" />
        </shape>
    </item>
</layer-list>
