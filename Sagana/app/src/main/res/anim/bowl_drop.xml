<?xml version="1.0" encoding="utf-8"?>
<!-- Opening screen: logo drops in and bounces -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/overshoot_interpolator"
    android:duration="800">
    <translate android:fromYDelta="-60%p" android:toYDelta="0" />
    <scale android:fromXScale="0.6" android:toXScale="1"
        android:fromYScale="0.6" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="400" />
</set>
