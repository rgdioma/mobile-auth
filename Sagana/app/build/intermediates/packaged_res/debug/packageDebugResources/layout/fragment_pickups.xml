<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rice"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_pickups"
            android:textColor="@color/adobo"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Warning Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top"
                android:layout_marginTop="2dp"
                android:contentDescription="@string/cd_food_icon"
                android:src="@drawable/ic_restaurant"
                app:tint="@color/placeholder_ink" />

            <TextView
                android:id="@+id/textBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/pickup_banner_text"
                android:textColor="@color/placeholder_ink"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Calendar Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_calendar"
            android:padding="12dp">

            <CalendarView
                android:id="@+id/calendarView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:theme="@style/Theme.Sagana.Calendar" />
        </FrameLayout>

        <!-- Time Slot Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/label_time_slot"
            android:textColor="@color/adobo"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                style="@style/Widget.SaluBite.TimeChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_9am" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.SaluBite.TimeChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_11am" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.SaluBite.TimeChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_1pm" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.SaluBite.TimeChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_3pm" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.SaluBite.TimeChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_5pm" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.SaluBite.TimeChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_7pm" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Your Pickups Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="@string/label_your_pickups"
                android:textColor="@color/adobo"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="@string/pickup_count_zero"
                android:textColor="@color/icon_muted" />
        </RelativeLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/no_pickups_text"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </FrameLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>